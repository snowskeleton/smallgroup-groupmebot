# Copy to .env and fill in. See SETUP.md for where each value comes from.

# --- GroupMe (required) ---
BOT_ID=
BOT_NAME=
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=https://bot.example.com/oauth/callback

# --- Email (optional; without it the bot posts to GroupMe but can't send mail,
#     and the dashboard's magic-link login won't work) ---
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_ADDRESS=

# --- Dashboard (optional) ---
DASHBOARD_URL=https://bot.example.com

# --- Paths and locale (optional; defaults shown) ---
DB_PATH=messages.db
CREDENTIALS_PATH=credentials.json
TIMEZONE=America/New_York
